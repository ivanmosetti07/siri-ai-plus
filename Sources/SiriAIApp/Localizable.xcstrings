      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Facts Siri AI+ uses to give better answers: the ones you ask it to remember, the ones that came up in compacted conversations and a daily summary of activity. They stay on your Mac."
          }
        }
      }
    },

    },
    "Compattazione automatica al %lld%% del contesto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic compaction at %lld%% of context"
          }
        }
      }
    },
    "Compattazione: quando la conversazione esce dalla finestra del modello, un sub-agent la riassume (se è lunga altri sub-agent la leggono a pezzi in parallelo) e al modello arrivano il riassunto e gli ultimi scambi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compaction: when the conversation no longer fits in the model's window, a sub-agent summarizes it (if it's long, other sub-agents read it in chunks in parallel) and the model receives the summary and the latest exchanges."
          }
        }
      }
    },
    "Compila e correggi gli errori": {
      "localizations": {

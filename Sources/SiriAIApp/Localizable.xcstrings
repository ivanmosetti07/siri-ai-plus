            "value": "Changed instructions"
          }
        }
      }
    },
    "Istruzioni che Siri AI+ segue in ogni task di questo progetto. Se sono lunghe ne usa una sintesi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instructions that Siri AI+ follows in every task in this project. If they're long, it uses a summary."
          }
        }
      }
    },
    "Istruzioni ripristinate a prima del sogno del %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instructions restored to how they were before the dream from %@"
          }
        }
      }
    },
